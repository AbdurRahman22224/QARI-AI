# Optional: backend origin when not using Vite's /api proxy (e.g. production static build).
# Leave unset in dev to use same-origin /api (proxied to http://localhost:5000).
# VITE_API_URL=https://your-api.example.com

# Optional: override OAuth callback if your IdP cannot use dynamic redirect URIs.
# Default is `${window.location.origin}/callback` (correct for https://LAN-IP:3000).
# VITE_REDIRECT_URI=https://localhost:3000/callback
